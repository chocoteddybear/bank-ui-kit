{
  "name": "bank-ui-kit",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "start": "pnpm dev",
    "build": "pnpm -r build",
    "dev": "pnpm --filter @vladlev/skit watch",
    "dev:demo": "pnpm --filter @vladlev/skit build && pnpm --parallel --filter @vladlev/skit --filter demo run dev:watch",
    "storybook": "pnpm --filter @vladlev/skit storybook",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  }
}
