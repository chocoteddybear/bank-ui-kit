{
  "name": "@vladlev/skit",
  "version": "0.0.1",
  "description": "Angular UI kit for banking and financial apps.",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "build": "ng build && node scripts/build-css.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "eslint .",
    "storybook": "ng run ui:storybook",
    "build-storybook": "ng run ui:build-storybook",
    "dev:watch": "ng build --watch --configuration development"
  },
  "exports": {
    "./styles.css": "./styles.css",
    "./fonts.css": "./fonts.css",
    "./tailwind.css": "./tokens/tailwind.css",
    "./tokens/*": "./tokens/*"
  },
  "peerDependencies": {
    "@angular/common": "^22.2.0",
    "@angular/core": "^22.2.0",
    "tailwindcss": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "@angular-devkit/architect": "^0.2202.2",
    "@angular-devkit/core": "^22.2.2",
    "@angular/animations": "^22.2.2",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "5.3.0",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/angular-vite": "^10.6.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "eslint-plugin-better-tailwindcss": "4.9.1",
    "eslint-plugin-storybook": "^10.6.2",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.4",
    "postcss": "^8.5.30",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "storybook": "^10.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.4",
    "vitest": "^5.0.0"
  },
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "directory": "dist",
    "linkDirectory": true
  }
}
